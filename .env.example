# Copy to .env for mcp.json, or set these in the MCP host environment.
# Required for both catalogue tools; the niblet://skill resource works without it.
NIBLET_TOKEN=
# Optional. Defaults to https://api.niblet.com and https://media.niblet.com.
# Point them at a local deployment (for example http://localhost:3001) for development.
NIBLET_API_ORIGIN=
NIBLET_MEDIA_ORIGIN=
