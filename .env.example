# Optional for a manual self-hosted launch: node --env-file=.env src/index.mjs
# Required for the three catalogue tools against a self-hosted REST API; bundled resources and helpers work without it.
NIBLET_TOKEN=
# Optional. Defaults to https://api.niblet.com and https://media.niblet.com.
# Point them at a local deployment (for example http://localhost:3001) for development.
NIBLET_API_ORIGIN=
NIBLET_MEDIA_ORIGIN=
